"""
2 - Bir öğrencinin 2 yazılı 1 sözlü notunu alarak ortalama hesaplayınız ve hesaplanan ortalamaya göre not aralığına karşılık gelen değerlendirmeyi yazdırınız.
0-24 => 0
25-44 => 1
45-54 => 2
55-69 => 3
70-84 => 4
85-100 => 5
 """

yazili1 = float(input("1.yazılı notunuzu giriniz: "))
yazili2 = float(input("2.yazılı notunuzu giriniz: "))
sozlu = float(input("Sözlü notunuzu giriniz: "))    
ortalama = (yazili1 + yazili2 + sozlu) / 3

if (ortalama >= 0) and (ortalama <= 24):
    print(f"ortalama: {ortalama} ve Notunuz: 0")
elif (ortalama >= 25) and (ortalama <= 44):
    print(f"ortalama: {ortalama} ve Notunuz: 1")
elif (ortalama >= 45) and (ortalama <= 54):
    print(f"ortalama: {ortalama} ve Notunuz: 2")
elif (ortalama >= 55) and (ortalama <= 69):
    print(f"ortalama: {ortalama} ve Notunuz: 3")
elif (ortalama >= 70) and (ortalama <= 84):
    print(f"ortalama: {ortalama} ve Notunuz: 4")
elif (ortalama >= 85) and (ortalama <= 100):
    print(f"ortalama: {ortalama} ve Notunuz: 5")
else:
    print("Geçersiz not girdiniz.")
